<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vijay.aimagicremote">

    <!-- Required permissions for Magic Remote functionality -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ForegroundService" />
    
    <!-- TV discovery and remote control -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    
    <!-- Android TV specific -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Android TV Remote Protocol uses TLS -->
    
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />
    
    <application
        android:name=".AppInitializer"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MagicRemote">
        
        <!-- Main activity - the Magic Remote interface -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- Handle home button - go back to main remote screen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <!-- Companion app service - runs in background for connectivity -->
        <service
            android:name=".remote.TvConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataTransfer" />
        
        <!-- Bluetooth device discovery -->
        <receiver android:name=".bluetooth.BluetoothBroadcastReceiver">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.FOUND" />
            </intent-filter>
        </receiver>
        
        <!-- Pairing result receiver -->
        <receiver android:name=".bluetooth.PairingResultReceiver">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.PAIRING_REQUEST" />
            </intent-filter>
        </receiver>
        
    </application>
</manifest>